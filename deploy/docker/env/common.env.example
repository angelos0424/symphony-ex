# Shared runtime settings for all SymphonyEx containers.
# Tracker/project API access is separate from Codex repo/PR access.
GITHUB_TRACKER_TOKEN=replace-with-tracker-token
GITHUB_AGENT_TOKEN=replace-with-agent-token
# One-release compatibility alias only; do not set this together with split tokens.
# GITHUB_TOKEN=replace-with-legacy-token
TZ=Asia/Seoul
SYMPHONY_LOG_FORMAT=json
SYMPHONY_LOG_LEVEL=info
SYMPHONY_LOG_METADATA=issue_identifier,thread_id,turn_id,outcome_kind,gating_reason,class,conflict_keys
SYMPHONY_LOG_REDACT_KEYS=api_key,agent_token,token
SYMPHONY_LOG_MAX_METADATA_VALUE_LENGTH=500
